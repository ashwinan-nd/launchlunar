# Copy to .env / .env.local and fill in.

# N2YO "above" API (supplemental live satellite positions).
# Free key: https://www.n2yo.com/api/   — used by the Vite dev proxy.
# NOTE: a previously committed key is burned in git history and revoked;
# generate your own.
N2YO_API_KEY=your-key-here

# Space-Track credentials (bulk GP catalog refresh via scripts/fetch-spacetrack.mjs).
# Free account: https://www.space-track.org/   — put these in .env.local (gitignored).
ST_USER=your-spacetrack-username
ST_PASS=your-spacetrack-password
